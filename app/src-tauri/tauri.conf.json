{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dota Drafter",
  "version": "1.2.0",
  "identifier": "com.dotadrafter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dota Drafter",
        "width": 1380,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Dota Drafter — оверлей",
        "url": "index.html#overlay",
        "width": 400,
        "height": 660,
        "minWidth": 260,
        "minHeight": 56,
        "x": 40,
        "y": 120,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:* https://cdn.cloudflare.steamstatic.com https://avatars.steamstatic.com https://avatars.akamai.steamstatic.com https://avatars.cloudflare.steamstatic.com https://avatars.fastly.steamstatic.com; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Dota Drafter",
    "shortDescription": "Помощник драфта Dota 2",
    "longDescription": "Подсказки по драфту, мета героев, билды против вражеского драфта, оверлей поверх игры.",
    "resources": {
      "../../build/backend/dist/drafter-backend/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "headerImage": "windows/installer-header.bmp",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
