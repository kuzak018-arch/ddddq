# secrets: the token file and keys never go to git
.env
/secrets/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
build/
*.spec
!backend/drafter-backend.spec

# node / tauri
node_modules/
app/dist/
app/src-tauri/target/
app/src-tauri/binaries/
app/src-tauri/tauri.release.conf.json

# local data (matches, caches, models, icons, screenshots)
/data/
/exports/

# os / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# more secret patterns, in case one lands in the tree by accident (.env.example stays tracked)
.env.*
!.env.example
**/secrets/
*.key
*.pem
*.pfx
*.p12
*.keystore
*.jks
id_rsa*
*credentials*.json
.claude/settings.local.json

# logs and temporary files
*.log
logs/
*.tmp
*.temp
*.drafter-tmp
*.bak
*.swp
backups/
